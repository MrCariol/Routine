# Regole cache per il dispositivo (Nokia Lumia 735 / Edge), pensate per lavorare
# insieme al parametro ?v=APP_VERSION già presente su CSS/JS in index.html.
#
# - index.html, manifest.json, browserconfig.xml: MAI messi in cache dal
#   browser, così ogni apertura dell'app scarica sempre la pagina più recente
#   (che a sua volta decide quale versione di CSS/JS caricare).
# - css/js/font/immagini: possono restare in cache a lungo, tanto ogni volta
#   che il loro contenuto cambia, cambia anche l'URL (?v=...), quindi il
#   dispositivo scarica comunque il file nuovo.
#
# Nota: alcuni piani di hosting gratuiti (incluso Altervista) potrebbero
# limitare alcuni moduli Apache; se queste regole non hanno effetto, non
# causano comunque errori.

<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|xml)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff|woff2|ttf|eot|otf|svg|png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>

# Un hub di autenticazione puo' essere configurato per tornare su un path che
# qui non esiste (es. /auth/callback#token=...), dove l'app non c'e': niente
# router lato client, un solo index.html nella cartella dell'app (vedi
# CLAUDE.md). Quel path viene quindi rimandato alla root con un redirect
# esterno: il browser riporta da solo il fragment sull'URL di destinazione
# (RFC 7231), cosi' js/auth.js trova "#token=..." e lo consuma.
#
# Serve un redirect e non un rewrite interno: index.html carica CSS/JS con
# path relativi, quindi servirlo sotto /auth/ farebbe cercare gli script in
# /auth/js/... e l'app resterebbe bloccata sul loader.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # I file statici mancanti restano 404: non devono mai finire sulla root,
  # verrebbero interpretati come CSS/JS e romperebbero il caricamento.
  RewriteRule \.(css|js|json|xml|map|php|png|jpe?g|gif|svg|ico|woff2?|ttf|eot|otf)$ - [NC,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ / [R=302,L]
</IfModule>
