# Regole cache per il dispositivo (Nokia Lumia 735 / Edge), pensate per lavorare
# insieme al parametro ?v=APP_VERSION già presente su CSS/JS in index.html.
#
# - index.html, manifest.json, browserconfig.xml: MAI messi in cache dal
#   browser, così ogni apertura dell'app scarica sempre la pagina più recente
#   (che a sua volta decide quale versione di CSS/JS caricare).
# - css/js/font/immagini: possono restare in cache a lungo, tanto ogni volta
#   che il loro contenuto cambia, cambia anche l'URL (?v=...), quindi il
#   dispositivo scarica comunque il file nuovo.
#
# Nota: alcuni piani di hosting gratuiti (incluso Altervista) potrebbero
# limitare alcuni moduli Apache; se queste regole non hanno effetto, non
# causano comunque errori.

<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|xml)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff|woff2|ttf|eot|otf|svg|png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>

# SPA fallback: niente router lato client (vedi CLAUDE.md), un solo
# index.html in root. Un hub di autenticazione puo' essere configurato per
# reindirizzare su un path qualsiasi (es. /auth/callback#token=...): senza
# questa regola quel path darebbe 404 e il token nel fragment non verrebbe
# mai letto da js/auth.js. Non tocca api/ ne' i file statici esistenti,
# solo i path che non corrispondono a un file o cartella reale.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
